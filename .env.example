# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# DataForSEO API access (app.dataforseo.com/api-access): API login + API password
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# OpenRouter (openrouter.ai/keys). Use a key with a credit limit.
OPENROUTER_API_KEY=

# Live demo panel only. On Cloudflare these are set as Pages secrets, not read from this file.
# For local `npx wrangler pages dev`, copy these two lines into .dev.vars.
DEMO_PASSCODE=
